# Copy to .env. Every backend variable uses the TESTPILOT_ prefix.
POSTGRES_PASSWORD=change-me
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
TESTPILOT_SECRET_KEY=replace-with-a-long-random-string
# Optional Fernet key for encrypting stored secrets (derived from the secret key when empty).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TESTPILOT_ENCRYPTION_KEY=
TESTPILOT_ENVIRONMENT=production
TESTPILOT_CORS_ORIGINS=http://localhost:8080
